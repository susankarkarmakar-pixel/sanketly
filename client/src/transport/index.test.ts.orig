import 'fake-indexeddb/auto';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { connectTransport, disconnectTransport, sendMessage, sendGroupMessage, onMessage, onError } from './index';
import * as crypto from '@sanketly/crypto';
import { clear as clearIdb } from 'idb-keyval'; // Ensure IDB is fully cleared

// Mock fetch
const mockFetch = vi.fn();
globalThis.fetch = mockFetch as any;

// Mock idb-keyval to avoid indexedDB errors in jsdom
const mockStore = new Map<string, any>();
vi.mock('idb-keyval', () => ({
  get: vi.fn(async (key: string) => mockStore.get(key)),
  set: vi.fn(async (key: string, val: any) => mockStore.set(key, val)),
  clear: vi.fn(async () => mockStore.clear()),
}));

// Mock socket.io-client
let mockSocketEmit = vi.fn();
let mockSocketOn = vi.fn();
let mockSocketDisconnect = vi.fn();

const mockSocketInstance = {
  connected: false,
  emit: (...args: any[]) => mockSocketEmit(...args),
  on: (...args: any[]) => mockSocketOn(...args),
  disconnect: () => {
    mockSocketInstance.connected = false;
    mockSocketDisconnect();
  },
};

vi.mock('socket.io-client', () => ({
  io: vi.fn(() => {
    mockSocketInstance.connected = true;
    return mockSocketInstance;
  }),
}));

// Mock identity module
vi.mock('../identity', () => ({
  getOrCreateIdentity: vi.fn().mockResolvedValue({
    ed25519: { publicKey: 'ed25519-pub', secretKey: 'ed25519-sec' },
    x25519: { publicKey: 'x25519-pub', secretKey: 'x25519-sec' },
  }),
  signChallenge: vi.fn().mockResolvedValue('mock-signature'),
}));

// Mock uuid
vi.mock('uuid', () => ({
  v4: vi.fn(() => 'mock-uuid-1234'),
}));

describe('Transport Module Core', () => {
  beforeEach(async () => {
    vi.clearAllMocks();
    await clearIdb();
    mockStore.clear();
    mockSocketInstance.connected = false;
    localStorage.clear();

    await crypto.initCrypto();

    mockFetch.mockImplementation(async (url: string) => {
      if (url.endsWith('/register') || url.endsWith('/prekeys')) {
        return { ok: true };
      }
      if (url.endsWith('/auth/challenge')) {
        return { ok: true, json: async () => ({ challenge: 'mock-challenge' }) };
      }
      if (url.endsWith('/auth/verify')) {
        return { ok: true, json: async () => ({ sessionId: 'mock-session-id' }) };
      }
      if (url.includes('/prekeys/')) {
        const remoteId = crypto.generateIdentityKeyPair();
        const remotePreKey = crypto.generatePreKey(1);
        return {
          ok: true,
          json: async () => ({
            identityKey: crypto.serializeIdentityKeyPair(remoteId),
            prekey: {
              id: 1,
              key: crypto.serializePreKey(remotePreKey)
            }
          })
        };
      }
      return { ok: false };
    });

    mockSocketOn.mockImplementation((event, callback) => {
      if (event === 'connect') {
        setTimeout(callback, 0);
      }
    });
  });

  afterEach(() => {
    disconnectTransport();
  });

  it('should authenticate and connect socket successfully', async () => {
    await connectTransport('testuser');

    expect(mockFetch).toHaveBeenCalledTimes(4);
    expect(mockSocketInstance.connected).toBe(true);
  });

  it('should encrypt message before emitting to socket', async () => {
    await connectTransport('alice');

    const msgId = await sendMessage('bob', 'Hello Bob');

    expect(msgId).toBe('mock-uuid-1234');
    expect(mockSocketEmit).toHaveBeenCalledTimes(1);

    const [event, payload] = mockSocketEmit.mock.calls[0];
    expect(event).toBe('message:send');
    expect(payload.toUsername).toBe('bob');
    expect(payload.clientMessageId).toBe('mock-uuid-1234');

    expect(payload.content).not.toContain('Hello Bob');
    expect(typeof payload.content).toBe('string');
  });
});

describe('Transport Module Groups', () => {
  beforeEach(async () => {
    vi.clearAllMocks();
    await clearIdb();
    mockStore.clear();
    mockSocketInstance.connected = false;
    localStorage.clear();

    await crypto.initCrypto();

    mockFetch.mockImplementation(async (url: string) => {
      if (url.endsWith('/register') || url.endsWith('/prekeys')) return { ok: true };
      if (url.endsWith('/auth/challenge')) return { ok: true, json: async () => ({ challenge: 'mock-challenge' }) };
      if (url.endsWith('/auth/verify')) return { ok: true, json: async () => ({ sessionId: 'mock-session-id' }) };
      if (url.includes('/groups/mock-group-id')) {
        return {
          ok: true,
          json: async () => ({
            name: 'Mock Group',
            members: ['group_alice', 'bob', 'charlie']
          })
        };
      }
      if (url.includes('/prekeys/')) {
        const remoteId = crypto.generateIdentityKeyPair();
        const remotePreKey = crypto.generatePreKey(1);
        return {
          ok: true,
          json: async () => ({
            identityKey: crypto.serializeIdentityKeyPair(remoteId),
            prekey: {
              id: 1,
              key: crypto.serializePreKey(remotePreKey)
            }
          })
        };
      }
      return { ok: false };
    });

    mockSocketOn.mockImplementation((event, callback) => {
      if (event === 'connect') {
        setTimeout(callback, 0);
      }
    });
  });

  afterEach(() => {
    disconnectTransport();
  });

  it('should encrypt group message separately for each member and send correctly', async () => {
    await connectTransport('group_alice');
    mockSocketEmit.mockClear();
    console.log('mockStore keys before sendGroupMessage:', Array.from(mockStore.keys()));

    const msgId = await sendGroupMessage('mock-group-id', 'Hello Group!');

    expect(msgId).toBe('mock-uuid-1234');
    expect(mockSocketEmit).toHaveBeenCalledTimes(1);

    const [event, payload] = mockSocketEmit.mock.calls[0];
    expect(event).toBe('message:send');
    expect(payload.groupId).toBe('mock-group-id');
    expect(payload.clientMessageId).toBe('mock-uuid-1234');

    const ciphertexts = payload.ciphertextsByMember;
    expect(ciphertexts).toBeDefined();

    expect(ciphertexts['bob']).toBeDefined();
    expect(ciphertexts['charlie']).toBeDefined();
    expect(ciphertexts['group_alice']).toBeUndefined();
    expect(ciphertexts['bob']).not.toBe(ciphertexts['charlie']);
    expect(ciphertexts['bob']).not.toContain('Hello Group!');
  });

  it('should decrypt a received group message from a peer successfully', async () => {
    await connectTransport('bob_recipient');

    const messageCallback = vi.fn();
    const unsubscribe = onMessage(messageCallback);

    // Provide a mocked valid E2E Proteus cipher envelope coming from group_alice
    // First, let's create what Alice would send Bob so we have a valid payload
    const aliceId = crypto.generateIdentityKeyPair();
    const bobIdJson = localStorage.getItem('proteus_identity_bob_recipient');
    const bobId = crypto.deserializeIdentityKeyPair(bobIdJson!);

    const bobPreKey = crypto.deserializePreKey(localStorage.getItem('proteus_prekey_bob_recipient_1')!);

    const bobBundle = await crypto.constructPreKeyBundle(bobId, bobPreKey);
    const aliceSession = await crypto.initSessionAsSender('bob_recipient', aliceId, bobBundle);

    const envelope = await crypto.encryptMessage('bob_recipient', aliceSession, 'Decrypted Group Text');
    const b64Envelope = crypto.serializeEnvelope(envelope);

    const receiveHandlerCall = mockSocketOn.mock.calls.find(call => call[0] === 'message:receive');
    const handler = receiveHandlerCall![1];

    // Simulate socket incoming
    await handler({
      fromUsername: 'group_alice',
      groupId: 'mock-group-id',
      content: b64Envelope,
      clientMessageId: 'msg-abc',
      serverTimestamp: 123
    });

    // Validates B successfully decrypts using its own session with A
    expect(messageCallback).toHaveBeenCalledWith(expect.objectContaining({
      fromUsername: 'group_alice',
      groupId: 'mock-group-id',
      content: 'Decrypted Group Text'
    }));

    unsubscribe();
  });
});
